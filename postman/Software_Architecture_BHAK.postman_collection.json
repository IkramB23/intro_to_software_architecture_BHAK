{
	"info": {
		"name": "Software Architecture BHAK",
		"description": "Collection Postman pour tester l'API REST du projet Introduction to Software Architecture.\n\nWorkflow :\n1. Register un compte ADMIN\n2. Login pour obtenir le token JWT\n3. Utiliser le token pour les requetes CRUD admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		},
		{
			"key": "jwt_token",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.test('Inscription reussie', function () {",
									"        var json = pm.response.json();",
									"        pm.expect(json.username).to.eql('admin');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"email\": \"admin@bhak.com\",\n    \"phoneNumber\": \"+33600000001\",\n    \"password\": \"admin123\",\n    \"roleType\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Register USER",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"user1\",\n    \"email\": \"user1@bhak.com\",\n    \"phoneNumber\": \"+33600000002\",\n    \"password\": \"user123\",\n    \"roleType\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', json.token);",
									"    pm.test('Token JWT recupere', function () {",
									"        pm.expect(json.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login USER",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.test('Token JWT recupere', function () {",
									"        pm.expect(json.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"user1\",\n    \"password\": \"user123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Users CRUD (Admin)",
			"item": [
				{
					"name": "GET tous les utilisateurs (page 0)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/admin/users?page=0&size=10&sort=username",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sort", "value": "username" }
							]
						}
					}
				},
				{
					"name": "GET utilisateur par ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/admin/users/1",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users", "1"]
						}
					}
				},
				{
					"name": "POST creer un utilisateur",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"new_user\",\n    \"email\": \"newuser@bhak.com\",\n    \"phoneNumber\": \"+33600000003\",\n    \"password\": \"pass123\",\n    \"roleType\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/users",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"]
						}
					}
				},
				{
					"name": "PUT modifier un utilisateur",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"user_modifie\",\n    \"email\": \"modifie@bhak.com\",\n    \"phoneNumber\": \"+33600000099\",\n    \"password\": \"pass123\",\n    \"roleType\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/users/2",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users", "2"]
						}
					}
				},
				{
					"name": "DELETE supprimer un utilisateur",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/api/admin/users/2",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users", "2"]
						}
					}
				}
			]
		},
		{
			"name": "Tests securite",
			"item": [
				{
					"name": "GET users SANS token (doit retourner 403)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/admin/users",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"]
						}
					}
				},
				{
					"name": "GET endpoint racine (public)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/",
							"host": ["{{base_url}}"],
							"path": [""]
						}
					}
				}
			]
		}
	]
}
